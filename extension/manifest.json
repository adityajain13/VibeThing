{
  "manifest_version": 3,
  "name": "VibeThing for YouTube",
  "description": "Lets your CarThing like and unlike what's playing on YouTube and YouTube Music, through the VibeThing app on this PC.",
  "version": "1.0.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
